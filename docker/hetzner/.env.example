# Copy to .env (same directory) and fill in. .env is gitignored.

# Public hostname; point its DNS A/AAAA records at the server first.
PAPERCLIP_DOMAIN=paperclip.example.com
# Let's Encrypt contact address for the TLS certificate.
ACME_EMAIL=you@example.com

# Immutable image tag published by your fork's Docker workflow.
PAPERCLIP_IMAGE=ghcr.io/your-github-user/paperclip:sha-abc1234

# Generate each with: openssl rand -base64 32 | tr -d '/+=' | head -c 40
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=

# Used by backup.sh (restic to a Hetzner Storage Box or any restic backend).
RESTIC_REPOSITORY=sftp:u123456@u123456.your-storagebox.de:paperclip-backups
RESTIC_PASSWORD=
